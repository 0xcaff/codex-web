#!/usr/bin/env bash
set -euxo pipefail

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"' EXIT

APP_VERSION="26.707.30751"
APP_ZIP_SHA256="f81023845ae56ebb98b349e4bc81d7b490533564897cea0ea4fc4a17104f3892"
curl --fail --location --proto '=https' --tlsv1.2 \
  --output "$TEMP_DIR/file.zip" \
  "https://persistent.oaistatic.com/codex-app-prod/ChatGPT-darwin-arm64-$APP_VERSION.zip"
./scripts/verify_sha256 "$TEMP_DIR/file.zip" "$APP_ZIP_SHA256"

HOSTED_CODEX_APP_ZIP="$TEMP_DIR/file.zip" bash ./scripts/prepare_asar
